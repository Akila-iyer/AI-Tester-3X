# Visual UI Testing Platform — Secrets Template
# Copy to .env and fill in your keys (never commit .env to git)
# All values are optional; handshake scripts will skip unset providers.

# Figma Personal Access Token
# Get it from: Figma > Settings > Account > Personal Access Tokens
FIGMA_TOKEN=

# OpenAI API Key (for AI analysis layer)
# Optional — deterministic comparison works without AI
OPENAI_API_KEY=

# Local LLM (Ollama) endpoint (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
